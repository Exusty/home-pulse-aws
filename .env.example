# Copy to .env and fill locally. Never commit .env.
PORT=7860
HOME_PULSE_PROVIDER=standalone
HOME_PULSE_DATA_DIR=./runtime-data
HOME_PULSE_MODELS_DIR=./models
HOME_PULSE_MODEL_URL=http://127.0.0.1:8765
HOME_PULSE_MODEL_PORT=8765
HOME_PULSE_API_PORT=8791
HOME_PULSE_ALLOWED_ORIGINS=http://127.0.0.1:7860,http://localhost:7860
ANKER_KIMI_API_KEY=
# Optional remote GPU worker/bridge configuration; leave blank for one GPU host.
HOME_PULSE_WORKER_KEY=
HOME_PULSE_WORKER_URL=
HOME_PULSE_GPU_BRIDGE_KEY=
